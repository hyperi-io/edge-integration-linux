# EOL Enterprise Linux target image for yum distros (el6, el7).
# el7's python3 is 3.6, below ansible-core's target floor, so el7 does not
# converge yet. el6 is amd64-only.
# BASE comes from matrix.yml.
ARG BASE
FROM ${BASE}
RUN yum -y install python3 sudo procps-ng rsyslog audit \
 && yum clean all
