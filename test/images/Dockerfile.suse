# openSUSE Leap target image. Leap 15.6's python3 is 3.6, so this bakes in
# python311 and matrix.yml points ansible_python_interpreter at it.
# Leap reports ansible_distribution "openSUSE Leap", so the role installs "audit".
# BASE comes from matrix.yml.
ARG BASE
FROM ${BASE}
RUN zypper --non-interactive --gpg-auto-import-keys refresh \
 && zypper --non-interactive install python311 sudo procps rsyslog audit \
 && zypper clean --all
