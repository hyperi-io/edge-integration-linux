# Debian/Ubuntu target image. Bakes in python3 (for ansible), procps (the role
# reads `ps`), rsyslog and auditd so each converge is config-only.
# BASE comes from matrix.yml.
ARG BASE
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 sudo procps rsyslog auditd \
 && rm -rf /var/lib/apt/lists/*
