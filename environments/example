---
# Inventory template. Copy it, name the copy for your site, fill in the
# placeholders, then:
#
#   ansible-playbook site.yml -i environments/<the file you just created>
#
# The placeholders are quoted, so this file parses as shipped and a run against
# it fails on unreachable hosts rather than on the inventory.
all:
  hosts:
    # One line per host to audit.
    "<ip address or DNS name of host 1 here>":
    "<ip address or DNS name of host 2 here>":
    "<ip address or DNS name of host 3 here>":
  vars:
    # The syslog receiver for every host in this inventory, such as EdgeStream
    # Hub: audit records go to TCP 12201, other syslog to TCP 12205.
    hyperi_audit_receiver_address: "<ip address or DNS name of the receiver here>"

    # Connect with an SSH key. Keep any become password in an ansible-vault
    # file, or type it at -K, never here in plain text.
    # ansible_user: "deploy"

    # --- Ruleset (optional) ----------------------------------------------------
    # low | medium (default) | high. Each level holds the one below it.
    # hyperi_audit_level: "medium"
    # Overlays: any of webserver, edge, container-host.
    # hyperi_audit_use_cases: ["edge", "webserver"]

    # --- Transport (optional) --------------------------------------------------
    #   tcp        - plain TCP syslog, the default.
    #   syslog-tls - syslog over TLS. EdgeStream Hub accepts it.
    #   relp       - acknowledged delivery to a RELP receiver, not encrypted.
    #   relp-tls   - RELP over TLS.
    # EdgeStream Hub has no RELP ingest yet (see docs/transport.md).
    # hyperi_audit_transport: "syslog-tls"

    # TLS trust, for syslog-tls and relp-tls:
    #   anon   - encrypts, checks no certificate. Use it on a trusted path only.
    #            Hosts whose crypto policy turns off anonymous ciphers
    #            (RHEL 8 and later) need server or mutual.
    #   server - checks the receiver's certificate. Needs the CA. Not for
    #            relp-tls.
    #   mutual - both ends present certificates. Needs the CA, client cert and
    #            client key.
    # hyperi_audit_tls_mode: "server"
    # hyperi_audit_tls_ca_file: "/etc/pki/hyperi/ca.pem"
    # hyperi_audit_tls_permitted_peer: "receiver.example.com"
    # hyperi_audit_tls_client_cert: "/etc/pki/hyperi/client.pem"
    # hyperi_audit_tls_client_key: "/etc/pki/hyperi/client.key"

    # Receiver ports (defaults shown). For TLS, point them at the receiver's TLS
    # listener, such as 6514.
    # hyperi_audit_port_audit: "12201"
    # hyperi_audit_port_syslog: "12205"
