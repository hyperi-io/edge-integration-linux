-a always,exit -F arch=b64 -S open -S openat -F exit=-EACCES -F auid!=unset -F auid>=1000 -F dir=/etc -k T1068_denied
-a always,exit -F arch=b64 -S open -S openat -F exit=-EPERM  -F auid!=unset -F auid>=1000 -F dir=/etc -k T1068_denied
-a always,exit -F arch=b64 -S open -S openat -F exit=-EACCES -F auid!=unset -F auid>=1000 -F dir=/root -k T1068_denied
-a always,exit -F arch=b64 -S open -S openat -F exit=-EPERM  -F auid!=unset -F auid>=1000 -F dir=/root -k T1068_denied
-a always,exit -F arch=b64 -S openat2 -F exit=-EACCES -F auid!=unset -F auid>=1000 -F dir=/etc -k T1068_denied
