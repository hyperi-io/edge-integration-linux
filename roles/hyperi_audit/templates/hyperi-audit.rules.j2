# {{ ansible_managed }}
# HyperI auditd ruleset. Level {{ hyperi_audit_effective_level }}, overlays: {{ hyperi_audit_effective_use_cases | join(', ') or 'none' }}.
# Source: edge-integration-linux, roles/hyperi_audit/templates/hyperi-audit.rules.j2
# License: Apache-2.0. Copyright (c) 2026 HYPERI PTY LIMITED.
#
# LINEAGE. Forked from Neo23x0 (Florian Roth) "Best Practice Auditd
# Configuration" (Apache-2.0), then merged in turn with the public baselines:
#   Neo23x0 (Florian Roth) -> ACSC (ASD) OpenSCAP -> NIST -> DISA STIG
#   -> alphagov/GDS -> US DoD -> SigmaHQ
# Rules marked "sigma:" exist so a SigmaHQ auditd rule can fire. Detection logic
# from SigmaHQ (https://github.com/SigmaHQ/sigma), Detection Rule License 1.1.
# Keys carry MITRE ATT&CK technique ids where mapped. Keys are part of the
# output contract: rename one and every search on it goes blind.
#
# LAYERS. low is the base. medium adds to low, high adds to medium. Overlays
# (webserver, edge, container-host) add or remove rules for what the host does.
#
# COST. A syscall walks every rule whose syscall mask includes it. A `-w dir/`
# watch has every syscall in its mask, about 15 ns on each syscall the host
# makes. The same watch as `-a always,exit -F arch=b64 -F perm=wa -F dir=` gets
# a mask of only the syscalls perm= covers, about a quarter of the cost, so
# directories that exist are written that way. Rules with no -S and no perm=
# cost every syscall too. File watches hash by inode and cost only the
# syscalls that touch a path. Within a rule the kernel stops at the first field
# that fails, so the cheapest, most selective field goes first.
# test/lab/bench.sh and test/lab/dirform.sh measure this on a real kernel.
#
# ORDER. The first rule that matches an event decides it, in load order, file
# watches included. A never rule must come before every always rule it is meant
# to silence, and the execution rules sit above the excludes so no exclude can
# hide them. test/lab/semantics.sh checks this on a real kernel.
#
# ADDING A SYSCALL. Give it its own line. An unknown syscall name makes auditctl
# drop the whole rule, and -i hides that, so appending a new syscall to a
# working -S list deletes the rule on older kernels.
{% set lvl = {'low': 1, 'medium': 2, 'high': 3}[hyperi_audit_effective_level] %}
{% set uc = hyperi_audit_effective_use_cases %}
{#
  A directory watch: syscall-scoped where the directory exists, a path watch
  where it does not (a missing directory cannot take a dir= rule). Every path
  must be in vars/main.yml, or the render fails on the undefined name.
#}
{% macro wdir(path, perm, key) -%}
{% if path not in hyperi_audit_watch_dirs %}{{ hyperi_audit_watch_dirs_is_missing_this_path[path] }}{% endif -%}
{% if path in hyperi_audit_present_dirs | default([]) -%}
-a always,exit -F arch=b64 -F perm={{ perm }} -F dir={{ path }} -k {{ key }}
{%- else -%}
-w {{ path }}/ -p {{ perm }} -k {{ key }}
{%- endif %}
{%- endmacro %}

## --- Control ---------------------------------------------------------------
-D
## -i first: lines an older kernel or auditctl does not know are skipped, not
## fatal. It reacts to the running kernel, so it is right per host.
-i
-b {{ 16384 if lvl == 3 else 8192 }}
## 0 drops events when the backlog is full instead of blocking the syscall,
## which on a busy host stalls every process. Kernel 3.14+.
--backlog_wait_time 0
--loginuid-immutable
-f 1

## --- Execution from writable or unusual locations ---------------------------
-a always,exit -F arch=b64 -S execve -F euid=0 -F dir=/tmp           -k T1059_root_tmp
-a always,exit -F arch=b64 -S execveat -F euid=0 -F dir=/tmp           -k T1059_root_tmp
-a always,exit -F arch=b64 -S execve -F euid=0 -F dir=/var/tmp       -k T1059_root_vartmp
-a always,exit -F arch=b64 -S execveat -F euid=0 -F dir=/var/tmp       -k T1059_root_vartmp
-a always,exit -F arch=b64 -S execve -F euid=0 -F dir=/dev/shm       -k T1059_root_devshm
-a always,exit -F arch=b64 -S execveat -F euid=0 -F dir=/dev/shm       -k T1059_root_devshm
-a always,exit -F arch=b64 -S execve -F dir=/dev/shm                 -k T1059_devshm_exec
-a always,exit -F arch=b64 -S execveat -F dir=/dev/shm                 -k T1059_devshm_exec
-a always,exit -F arch=b64 -S execve -F euid=0 -C uid!=euid          -k T1059_setuid_exec
-a always,exit -F arch=b64 -S execveat -F euid=0 -C uid!=euid        -k T1059_setuid_exec
{% if lvl >= 2 %}
-a always,exit -F arch=b64 -S execve -F euid=0 -F dir=/home          -k T1059_root_home
-a always,exit -F arch=b64 -S execveat -F euid=0 -F dir=/home          -k T1059_root_home
-a always,exit -F arch=b64 -S execve -F euid=0 -F dir=/usr/local/bin -k T1059_root_localbin
-a always,exit -F arch=b64 -S execveat -F euid=0 -F dir=/usr/local/bin -k T1059_root_localbin
-a always,exit -F arch=b64 -S execve -F euid=0 -F dir=/opt           -k T1059_root_opt
-a always,exit -F arch=b64 -S execveat -F euid=0 -F dir=/opt           -k T1059_root_opt
-a always,exit -F arch=b64 -S execve -F egid=0 -C gid!=egid          -k T1059_setgid_exec
{% endif %}
{% if lvl >= 3 %}
-a always,exit -F arch=b64 -S execve -F dir=/tmp                     -k T1059_tmp_exec
-a always,exit -F arch=b64 -S execveat -F dir=/tmp                     -k T1059_tmp_exec
-a always,exit -F arch=b64 -S execve -F dir=/var/tmp                 -k T1059_tmp_exec
-a always,exit -F arch=b64 -S execveat -F dir=/var/tmp                 -k T1059_tmp_exec
{% endif %}
{% if 'webserver' in uc %}
## Every command a web server account runs: the webshell and RCE signal.
## sigma: syscall/lnx_auditd_web_rce.yml
{% for uid in hyperi_audit_webserver_uids | default([]) %}
-a always,exit -F arch=b64 -S execve   -F euid={{ uid }} -k T1505.003_webshell
-a always,exit -F arch=b64 -S execveat -F euid={{ uid }} -k T1505.003_webshell
{% endfor %}
{% endif %}

## --- Noise excludes ---------------------------------------------------------
## One msgtype per line. The exclude list takes no key.
{% if lvl == 1 %}
-a always,exclude -F msgtype=CWD
{% endif %}
-a always,exclude -F msgtype=EOE
-a always,exclude -F msgtype=CRYPTO_KEY_USER
-a never,user -F subj_type=crond_t -k T1053_cron_ignore
## Shared memory and LVM lock churn, for the file-change syscalls only, so
## execution from /dev/shm stays visible.
-a never,exit -F arch=b64 -S rmdir -S unlink -S unlinkat -S rename -S renameat -F dir=/dev/shm -k T1135_sharedmem_ignore
-a never,exit -F arch=b64 -S renameat2 -F dir=/dev/shm -k T1135_sharedmem_ignore
-a never,exit -F arch=b64 -S chmod -S fchmodat -S chown -S fchownat -S lchown -F dir=/dev/shm -k T1135_sharedmem_ignore
-a never,exit -F arch=b64 -S fchmodat2 -F dir=/dev/shm -k T1135_sharedmem_ignore
-a never,exit -F arch=b64 -S rmdir -S unlink -S unlinkat -S rename -S renameat -F dir=/var/lock/lvm -k exclude_locklvm
-a never,exit -F arch=b64 -S renameat2 -F dir=/var/lock/lvm -k exclude_locklvm
-a never,filesystem -F fstype=tracefs -k exclude_tracefs
-a never,filesystem -F fstype=debugfs -k exclude_debugfs
{% if lvl >= 2 %}
## Time daemons call adjtimex every few seconds.
-a never,exit -F arch=b64 -S adjtimex -F exe=/usr/sbin/chronyd -k T1099_timesync_ignore
-a never,exit -F arch=b64 -S adjtimex -F exe=/usr/sbin/ntpd -k T1099_timesync_ignore
-a never,exit -F arch=b64 -S adjtimex -F exe=/usr/lib/systemd/systemd-timesyncd -k T1099_timesync_ignore
-a never,exit -F arch=b64 -S adjtimex -F exe=/usr/bin/vmtoolsd -k T1099_timesync_ignore
{% endif %}
{% if lvl >= 3 %}
## Common commands in logged-in sessions, which the privilege-context rule below
## would otherwise log on every sudo. auid!=unset keeps daemons and web server
## accounts out of the exclude.
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/grep   -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/sleep  -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/ls     -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/cat    -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/less   -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/more   -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/head   -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/tail   -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/which  -F perm=x -k T1059_exclude
-a never,exit -F arch=b64 -S execve -F auid!=unset -F auid>=1000 -F path=/usr/bin/sort   -F perm=x -k T1059_exclude
{% endif %}
{% if 'container-host' in uc %}
## The runtime's own namespace, mount and BPF calls on every container start.
-a never,exit -F arch=b64 -S setns -S unshare -S mount -S umount2 -S bpf -F exe=/usr/bin/runc -k T1611_runtime_ignore
-a never,exit -F arch=b64 -S setns -S unshare -S mount -S umount2 -S bpf -F exe=/usr/bin/crun -k T1611_runtime_ignore
-a never,exit -F arch=b64 -S setns -S unshare -S mount -S umount2 -S bpf -F exe=/usr/bin/containerd -k T1611_runtime_ignore
-a never,exit -F arch=b64 -S setns -S unshare -S mount -S umount2 -S bpf -F exe=/usr/bin/dockerd -k T1611_runtime_ignore
-a never,exit -F arch=b64 -S setns -S unshare -S mount -S umount2 -S bpf -F exe=/usr/bin/conmon -k T1611_runtime_ignore
-a never,exit -F arch=b64 -S setns -S unshare -S mount -S umount2 -S bpf -F pid=1 -k T1611_runtime_ignore
{% endif %}
{% if 'webserver' in uc %}
## Web server accounts connect to their backends on every request.
{% for uid in hyperi_audit_webserver_uids | default([]) %}
-a never,exit -F arch=b64 -S connect -F euid={{ uid }} -k T1071_webserver_ignore
{% endfor %}
{% endif %}

