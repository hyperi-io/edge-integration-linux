## --- 32-bit ABI tripwire ----------------------------------------------------
## Every other rule is b64. These catch a 32-bit process doing what those
## rules watch, without logging every syscall a legitimate 32-bit app makes.
-a always,exit -F arch=b32 -S execve -F key=32bit-abi
-a always,exit -F arch=b32 -S open -F key=32bit-abi
-a always,exit -F arch=b32 -S openat -F key=32bit-abi
-a always,exit -F arch=b32 -S socketcall -F key=32bit-abi
-a always,exit -F arch=b32 -S connect -F key=32bit-abi
-a always,exit -F arch=b32 -S ptrace -F key=32bit-abi
-a always,exit -F arch=b32 -S init_module -F key=32bit-abi
-a always,exit -F arch=b32 -S finit_module -F key=32bit-abi
-a always,exit -F arch=b32 -S setuid32 -F key=32bit-abi
-a always,exit -F arch=b32 -S personality -F key=32bit-abi

