## --- High: interpreters, privilege context, failed access ------------------
-a always,exit -F arch=b64 -S execve -F auid=0 -F path=/usr/bin/bash -F perm=x -k T1059.004_root_shell
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/python3 -F perm=x -k T1059.006_python
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/python  -F perm=x -k T1059.006_python
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/perl    -F perm=x -k T1059.006_perl
## auid!=unset is required: daemons run with auid unset and uid 0, so without
## it this matches every process every service starts.
-a always,exit -F arch=b64 -S execve -F auid!=unset -C auid!=uid -k T1548.001_priv_ctx_exec
-a always,exit -F arch=b64 -S execveat -F auid!=unset -C auid!=uid -k T1548.001_priv_ctx_exec
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -F auid!=unset -k T1548.001_setid
-a always,exit -F arch=b64 -S setresuid -S setresgid -F auid!=unset -k T1548.001_setid
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -F exit=-EPERM -k T1548.001_setid_fail
