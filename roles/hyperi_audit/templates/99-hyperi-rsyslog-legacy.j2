# {{ ansible_managed }}
# Forwards audit.log and local syslog to the receiver, for rsyslog below 7.
# Source: edge-integration-linux, roles/hyperi_audit. License: Apache-2.0.
{% set mode = hyperi_audit_tls_mode %}
{% set legacy_addr = '[' ~ hyperi_audit_receiver_address ~ ']' if ':' in hyperi_audit_receiver_address else hyperi_audit_receiver_address %}
{% if hyperi_audit_transport == 'syslog-tls' %}

# These directives switch the @@ forwards below to TLS.
$DefaultNetstreamDriver gtls
{% if hyperi_audit_tls_ca_file | length > 0 %}
$DefaultNetstreamDriverCAFile {{ hyperi_audit_tls_ca_file }}
{% endif %}
{% if mode == 'mutual' %}
$DefaultNetstreamDriverCertFile {{ hyperi_audit_tls_client_cert }}
$DefaultNetstreamDriverKeyFile {{ hyperi_audit_tls_client_key }}
{% endif %}
$ActionSendStreamDriverMode 1
$ActionSendStreamDriverAuthMode {{ 'anon' if mode == 'anon' else 'x509/name' }}
{% if mode != 'anon' %}
$ActionSendStreamDriverPermittedPeer {{ hyperi_audit_tls_peer }}
{% endif %}
{% endif %}
{% if not hyperi_audit_rsyslog_workdir_set | default(false) %}

# Disk queues and imfile state need a work directory, and el6 ships it unset.
$WorkDirectory /var/lib/rsyslog
{% endif %}

$ModLoad imfile
$InputFileName /var/log/audit/audit.log
$InputFileTag auditd:
$InputFileStateFile audit_log
$InputFileSeverity info
$InputRunFileMonitor

# Rules run top-down for every message, so the audit stream goes first and
# stops before the catch-all. Each $Action* block applies to the next action.
$ActionQueueType LinkedList
$ActionQueueFileName hyperi_audit
$ActionQueueMaxDiskSpace 1g
$ActionQueueSaveOnShutdown on
$ActionResumeRetryCount -1
if $programname == 'auditd' then @@{{ legacy_addr }}:{{ hyperi_audit_port_audit }}
if $programname == 'auditd' then stop

$ActionQueueType LinkedList
$ActionQueueFileName hyperi_syslog
$ActionQueueMaxDiskSpace 1g
$ActionQueueSaveOnShutdown on
$ActionResumeRetryCount -1
*.* @@{{ legacy_addr }}:{{ hyperi_audit_port_syslog }}
