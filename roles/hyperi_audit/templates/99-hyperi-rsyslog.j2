# {{ ansible_managed }}
# Forwards audit.log and local syslog to the receiver.
# Source: edge-integration-linux, roles/hyperi_audit. License: Apache-2.0.
{% set transport = hyperi_audit_transport %}
{% set mode = hyperi_audit_tls_mode %}
{% set auth = 'anon' if mode == 'anon' else 'x509/name' %}
{#
  Each stream gets a disk-assisted queue: records spool to rsyslog's work directory while the
  receiver is unreachable, and survive an rsyslog restart.
#}
{% macro queue(name) %}queue.type="LinkedList" queue.size="10000" queue.filename="{{ name }}" queue.maxDiskSpace="1g" queue.saveOnShutdown="on" action.resumeRetryCount="-1"{% endmacro %}
{% macro fwd(port, name) -%}
{% if transport in ['relp', 'relp-tls'] -%}
action(type="omrelp" target="{{ hyperi_audit_receiver_address }}" port="{{ port }}"
{%- if transport == 'relp-tls' %} tls="on"
{%- if mode == 'mutual' %} tls.authMode="name" tls.caCert="{{ hyperi_audit_tls_ca_file }}" tls.myCert="{{ hyperi_audit_tls_client_cert }}" tls.myPrivKey="{{ hyperi_audit_tls_client_key }}" tls.permittedPeer="{{ hyperi_audit_tls_peer }}"{% endif %}
{%- endif %} {{ queue(name) }})
{%- else -%}
action(type="omfwd" target="{{ hyperi_audit_receiver_address }}" port="{{ port }}" protocol="tcp"
{%- if transport == 'syslog-tls' %} StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="{{ auth }}"
{%- if mode != 'anon' %} StreamDriverPermittedPeers="{{ hyperi_audit_tls_peer }}"{% endif %}
{%- endif %} {{ queue(name) }})
{%- endif %}
{%- endmacro %}
{% if transport == 'syslog-tls' %}

global(
  DefaultNetstreamDriver="gtls"
{% if hyperi_audit_tls_ca_file | length > 0 %}
  DefaultNetstreamDriverCAFile="{{ hyperi_audit_tls_ca_file }}"
{% endif %}
{% if mode == 'mutual' %}
  DefaultNetstreamDriverCertFile="{{ hyperi_audit_tls_client_cert }}"
  DefaultNetstreamDriverKeyFile="{{ hyperi_audit_tls_client_key }}"
{% endif %}
)
{% elif transport in ['relp', 'relp-tls'] %}

module(load="omrelp")
{% endif %}

*.* {{ fwd(hyperi_audit_port_syslog, 'hyperi_syslog') }}

# The audit stream has its own ruleset, so its lines never reach the *.* action.
module(load="imfile")
input(type="imfile" File="/var/log/audit/audit.log" Tag="auditd" ruleset="hyperi_audit" PersistStateInterval="200")
ruleset(name="hyperi_audit") {
  {{ fwd(hyperi_audit_port_audit, 'hyperi_audit') }}
}
