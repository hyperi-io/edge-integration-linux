# export-ignore paths are left out of `git archive`, which build-tarball.sh
# uses for the deploy artefact. Untracked files never ship, so only tracked
# development files need listing here.
/build-tarball.sh export-ignore
/.github         export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.ansible-lint   export-ignore
/.hadolint.yaml  export-ignore
/renovate.json   export-ignore
/test            export-ignore
